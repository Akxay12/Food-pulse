rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. User Profiles: users/{userId}
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isOwner(userId);
    }

    // 2. Food Shops / Stalls: shops/{shopId}
    match /shops/{shopId} {
      // Public reading allowed for shared map & stall listings
      allow read: if true;
      
      // Shop creation requires auth and matching ownerId
      allow create: if isAuthenticated() 
                    && request.resource.data.ownerId == request.auth.uid;
      
      // Only owner can update shop details or change status
      allow update: if isOwner(resource.data.ownerId)
                    || (
                      // Or allow aggregate rating updates by system/authenticated callers
                      isAuthenticated()
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'hygieneRating', 'foodQualityRating', 'reviewCount'])
                    );
      
      allow delete: if isOwner(resource.data.ownerId);
    }

    // 3. Community Reviews: reviews/{reviewId}
    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if isAuthenticated() 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.rating >= 1 
                    && request.resource.data.rating <= 5
                    && (request.resource.data.targetType == 'food' || request.resource.data.targetType == 'shop');

      allow update: if isOwner(resource.data.userId)
                    || (
                      isAuthenticated() 
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'dislikesCount'])
                    );
      
      allow delete: if isOwner(resource.data.userId);

      // Subcollection likes & dislikes
      match /likes/{userId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }

      match /dislikes/{userId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }
    }

    // 4. Food Scans (Private User History): foodScans/{scanId}
    match /foodScans/{scanId} {
      // Strictly private: only owner can read their scans
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 5. Food Vlogger Videos: videos/{videoId}
    match /videos/{videoId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.authorId == request.auth.uid
      );
      allow update: if (resource.data.userId == request.auth.uid || resource.data.authorId == request.auth.uid)
                    || (
                      isAuthenticated()
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentsCount', 'sharesCount'])
                    );
      allow delete: if (resource.data.userId == request.auth.uid || resource.data.authorId == request.auth.uid);

      match /likes/{userId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }
    }

    // 6. User In-App Notifications: notifications/{notificationId}
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
