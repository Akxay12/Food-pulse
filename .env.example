# =========================================================
# FoodCheck Mobile Application Environment Configuration
# =========================================================
# Copy this file to `.env` in the project root and fill in your keys.
# Note: In Vite, client-side environment variables are prefixed with VITE_.

# ---------------------------------------------------------
# 1. Firebase Web Configuration (Authentication & Cloud Firestore)
# ---------------------------------------------------------
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKeyHere"
VITE_FIREBASE_AUTH_DOMAIN="foodcheck-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="foodcheck-app"
VITE_FIREBASE_STORAGE_BUCKET="foodcheck-app.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# ---------------------------------------------------------
# 2. Google Gemini Vision AI (AI Food Scanner)
# ---------------------------------------------------------
# Accepts either VITE_AI_API_KEY or AI_API_KEY (Gemini 2.5 Flash Vision API)
# If left empty, the application uses realistic AI vision analysis simulations.
VITE_AI_API_KEY=""
AI_API_KEY=""

# ---------------------------------------------------------
# 3. Google Maps JavaScript API (Shared Food Map & Stall Picker)
# ---------------------------------------------------------
# Accepts either VITE_MAPS_API_KEY or MAPS_API_KEY
# If left empty, the interactive FoodCheck mobile map with custom radar & markers is displayed.
VITE_MAPS_API_KEY=""
MAPS_API_KEY=""
